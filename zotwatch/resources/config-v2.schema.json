{
  "$comment": "Generated by the ZotWatch engine; credentials are not config fields.",
  "$defs": {
    "AIConfigV2": {
      "additionalProperties": false,
      "properties": {
        "features": {
          "$ref": "#/$defs/AIFeaturesConfig"
        },
        "services": {
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,47}$": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CustomServiceConfig"
                },
                {
                  "$ref": "#/$defs/PresetServiceConfig"
                }
              ]
            }
          },
          "title": "Services",
          "type": "object"
        }
      },
      "required": [
        "services",
        "features"
      ],
      "title": "AIConfigV2",
      "type": "object"
    },
    "AIFeaturesConfig": {
      "additionalProperties": false,
      "properties": {
        "rerank": {
          "$ref": "#/$defs/FeatureRouteConfig"
        },
        "summary": {
          "$ref": "#/$defs/FeatureRouteConfig"
        }
      },
      "required": [
        "rerank",
        "summary"
      ],
      "title": "AIFeaturesConfig",
      "type": "object"
    },
    "CandidatesConfigV2": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "public-api-v1",
          "title": "Provider",
          "type": "string"
        },
        "sources": {
          "items": {
            "enum": [
              "crossref",
              "arxiv",
              "biorxiv",
              "medrxiv",
              "openalex"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "window_days": {
          "const": 7,
          "title": "Window Days",
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "sources",
        "window_days"
      ],
      "title": "CandidatesConfigV2",
      "type": "object"
    },
    "CustomServiceConfig": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "maxLength": 2048,
          "minLength": 9,
          "pattern": "^https://[^\\s?#]+$",
          "title": "Base Url",
          "type": "string"
        },
        "connection_id": {
          "enum": [
            "custom-1",
            "custom-2",
            "custom-3",
            "custom-4"
          ],
          "title": "Connection Id",
          "type": "string"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Model",
          "type": "string"
        },
        "protocol": {
          "enum": [
            "openai-compatible-generation",
            "anthropic-compatible-generation"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "provider": {
          "const": "custom",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "protocol",
        "base_url",
        "model",
        "connection_id"
      ],
      "title": "CustomServiceConfig",
      "type": "object"
    },
    "EmbeddingConfigV2": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "sentence-transformers/all-MiniLM-L6-v2",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "const": "local",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "EmbeddingConfigV2",
      "type": "object"
    },
    "FeatureBudgetConfig": {
      "additionalProperties": false,
      "properties": {
        "max_input_tokens": {
          "default": 12000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_items": {
          "default": 20,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 2000,
          "maximum": 32000,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_requests": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 30,
          "maximum": 120,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "FeatureBudgetConfig",
      "type": "object"
    },
    "FeatureRouteConfig": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeatureBudgetConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "service": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "FeatureRouteConfig",
      "type": "object"
    },
    "OutputsConfigV2": {
      "additionalProperties": false,
      "properties": {
        "formats": {
          "items": {
            "enum": [
              "rss",
              "html",
              "json"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Formats",
          "type": "array"
        },
        "publish": {
          "title": "Publish",
          "type": "boolean"
        }
      },
      "required": [
        "formats",
        "publish"
      ],
      "title": "OutputsConfigV2",
      "type": "object"
    },
    "PresetServiceConfig": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "enum": [
            "voyage",
            "dashscope",
            "openrouter",
            "deepseek",
            "openai",
            "anthropic"
          ],
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "PresetServiceConfig",
      "type": "object"
    },
    "RankingConfigV2": {
      "additionalProperties": false,
      "properties": {
        "max_preprint_ratio": {
          "const": 0.3,
          "title": "Max Preprint Ratio",
          "type": "number"
        },
        "policy": {
          "const": "legacy-v1",
          "title": "Policy",
          "type": "string"
        },
        "top_n": {
          "maximum": 200,
          "minimum": 1,
          "title": "Top N",
          "type": "integer"
        }
      },
      "required": [
        "policy",
        "top_n",
        "max_preprint_ratio"
      ],
      "title": "RankingConfigV2",
      "type": "object"
    },
    "ZoteroConfigV2": {
      "additionalProperties": false,
      "properties": {
        "library_type": {
          "const": "user",
          "title": "Library Type",
          "type": "string"
        }
      },
      "required": [
        "library_type"
      ],
      "title": "ZoteroConfigV2",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ai": {
      "$ref": "#/$defs/AIConfigV2"
    },
    "candidates": {
      "$ref": "#/$defs/CandidatesConfigV2"
    },
    "embedding": {
      "$ref": "#/$defs/EmbeddingConfigV2"
    },
    "outputs": {
      "$ref": "#/$defs/OutputsConfigV2"
    },
    "ranking": {
      "$ref": "#/$defs/RankingConfigV2"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "zotero": {
      "$ref": "#/$defs/ZoteroConfigV2"
    }
  },
  "required": [
    "schema_version",
    "zotero",
    "candidates",
    "ranking",
    "embedding",
    "ai",
    "outputs"
  ],
  "title": "ZotWatch ordinary config schema v2",
  "type": "object"
}
