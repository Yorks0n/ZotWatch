# Generic API-format connection; no vendor-specific environment variable names.
LLM_API_FORMAT=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=replace-with-local-key
# Optional per-feature models; fallback to LLM_MODEL:
# LLM_TRANSLATION_MODEL=
# LLM_SHADOW_MODEL=
# For Anthropic Messages format: LLM_API_FORMAT=anthropic
# Set LLM_BASE_URL and LLM_MODEL to the chosen compatible service.
